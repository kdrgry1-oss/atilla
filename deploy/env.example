# ——— ZORUNLU ———
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=atilla_yenimarka
JWT_SECRET=                      # openssl rand -hex 32
CORS_ORIGINS=https://yenimarka.com,https://www.yenimarka.com
BACKEND_URL=https://api.yenimarka.com
FRONTEND_URL=https://yenimarka.com
ADMIN_INITIAL_PASSWORD=          # ilk girişten sonra değiştirin

# ——— ÖDEME (iyzico) ———
IYZICO_API_KEY=
IYZICO_SECRET=
IYZICO_BASE_URL=https://api.iyzipay.com

# ——— GÖRSEL DEPOSU (Cloudflare R2) ———
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CDN_URL=https://cdn.yenimarka.com

# ——— VERİTABANI YEDEĞİ (deploy/backup.sh) ———
# AYRI ve GİZLİ bucket (public erişim KAPALI) — medya bucket'ı (R2_BUCKET) ile AYNI OLAMAZ.
R2_BACKUP_BUCKET=
# Önerilen: yalnız yedek bucket'ına yazabilen ayrı R2 anahtarı (boşsa yukarıdaki kullanılır).
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# Yedek şifresi (en az 16 karakter). KAYBEDERSENİZ YEDEK AÇILAMAZ — sunucu dışında saklayın.
BACKUP_PASSPHRASE=

# ——— E-POSTA ———
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ——— KULLANILMAYACAKLAR (boş bırakın; boşsa ilgili işler çalışmaz) ———
# TRENDYOL_*, HEPSIBURADA_*, AMAZON_*, TEMU_*  → pazaryeri yok
# NETGSM_*                                     → SMS/İYS yok

# ——— BEYAZ ETİKET (kurulumun kendi kişileri — başka firmanın değeri koda gömülü DEĞİL) ———
ADMIN_INITIAL_EMAIL=             # panelin ilk yönetici e-postası
OWNER_SUPER_ADMIN_EMAILS=        # panel sahibi (virgülle)
ALERT_TO_EMAIL=                  # güvenlik uyarı alıcıları
ALERT_FROM_EMAIL=                # güvenlik uyarı gönderen adresi
ALERT_SMS_PHONE=                 # güvenlik SMS numarası (isteğe bağlı)
ORDER_NOTIFY_EMAIL=              # firma e-postası boşsa yeni sipariş bildirimi buraya
SITE_URL=
PUBLIC_API_URL=
